# Contact form (Resend) — copy to .env for local dev; set in Vercel for production
RESEND_API_KEY=
CONTACT_TO=jon@alwaysbequitting.com
# Until alwaysbequitting.com is verified as a domain in Resend, use the default:
CONTACT_FROM="ABQ Website <onboarding@resend.dev>"

# Email list (systeme.io) — the Quick-Start Guide opt-in endpoint
# Key: systeme.io dashboard → profile settings → "Public API keys"
SYSTEME_API_KEY=
# Numeric ID of the tag that triggers the Quick-Start Guide automation.
# Find it: GET https://api.systeme.io/api/tags  (X-API-Key header)
# Without it the contact is still created, but the guide email never sends.
SYSTEME_TAG_ID=

# Search engine site verification. Both are FALLBACKS only and both are
# optional: Google is already verified by DNS TXT, and Bing is verified by
# importing the Google property. Set either one only if the no-code route
# fails. Neither can verify before the Vercel cutover.
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_BING_SITE_VERIFICATION=

# Google reCAPTCHA v2 (contact form). Both blank = captcha stays off, form works.
PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Contact confirmation auto-reply. OFF unless set to exactly "true".
# It sends from no-reply@alwaysbequitting.com, which Resend rejects until the
# domain is verified. Leave unset/blank until then; set to true afterwards.
CONFIRMATION_ENABLED=
