---
// /contact - form → /api/contact → Resend → jon@alwaysbequitting.com
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/home.css';

// Google reCAPTCHA v2 checkbox. The widget and the server-side check BOTH stay
// inert until the keys exist, so the form keeps working before setup.
// Set PUBLIC_RECAPTCHA_SITE_KEY + RECAPTCHA_SECRET_KEY in Vercel (see SETUP.md).
const RECAPTCHA_SITE_KEY = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY;
---

<Base
  title="Contact Jon | Quit Smoking & Vaping Coaching | Always Be Quitting"
  description="Questions about quitting smoking or vaping? Get in touch with Jon Fritsch, a CTTS and NCNTT certified tobacco treatment specialist."
>
  <SiteHeader />

  <main class="band band--mist" style="padding-block: clamp(3.5rem, 7vw, 5.5rem)">
    <div class="wrap wrap--read">
      <h1 class="display-lg" style="margin-top:1rem">Contact <em>Always Be Quitting</em></h1>
      <p style="color:var(--soft); margin:1.2rem 0 0.9rem; font-size: var(--text-base)">
        If you do not get confirmation of your submission, please check your spam/junk mailbox. If you sort your
        mail into subcategories, it could be anywhere :)
      </p>
      <p style="color:var(--soft); margin:0 0 2rem; font-size: var(--text-base)">
        Please allow messages from alwaysbequitting.com in your email program so our response reaches you.
      </p>

      <div id="sent-banner" class="banner banner--ok" hidden>
        <strong>Message sent.</strong> Thanks - I'll get back to you soon. - Jon
      </div>
      <div id="error-banner" class="banner banner--err" hidden>
        <strong>Something went wrong.</strong> Your message didn't send - please try again in a moment.
      </div>
      <div id="captcha-banner" class="banner banner--err" hidden>
        <strong>Please confirm you're not a robot.</strong> Tick the reCAPTCHA box and send again.
      </div>

      <form class="contact-form" method="post" action="/api/contact">
        <label>
          <span class="label-row">Name <span class="req" aria-hidden="true">*</span></span>
          <input type="text" name="name" required maxlength="200" autocomplete="name" />
        </label>
        <label>
          <span class="label-row">Email Address <span class="req" aria-hidden="true">*</span></span>
          <input type="email" name="email" required maxlength="200" autocomplete="email" />
        </label>
        <label>
          <span class="label-row">Reason For Contact <span class="req" aria-hidden="true">*</span></span>
          <select name="reason" required>
            {/* "Trouble With Checkout Or Payment" sits second on purpose
                 (Jon, 2026-08-14): it's the only option where someone is
                 actively trying to give money and failing, so it needs to be
                 easy to find and easy to spot in the inbox. */}
            <option value="" disabled selected>Choose one</option>
            <option>General Comment</option>
            <option>Trouble With Checkout Or Payment</option>
            <option>Question About Services</option>
            <option>Business Inquiry</option>
            <option>Media Inquiry</option>
            <option>Speaking or Keynotes</option>
            <option>Trainings</option>
            <option>Other</option>
          </select>
        </label>
        <label>
          <span class="label-row">Your Message <span class="req" aria-hidden="true">*</span></span>
          <span class="field-note">
            Please don't send private health information through this form - it isn't a secure medium (see our <a href="/privacy">Privacy Policy</a>).
          </span>
          <textarea name="message" rows="7" required maxlength="5000"></textarea>
        </label>

        {/* honeypot: real users never fill this */}
        <label class="hp" aria-hidden="true">Company<input type="text" name="company" tabindex="-1" autocomplete="off" /></label>

        {RECAPTCHA_SITE_KEY ? (
          <div class="g-recaptcha" data-sitekey={RECAPTCHA_SITE_KEY}></div>
        ) : (
          <div class="captcha-placeholder">
            reCAPTCHA appears here once <code>PUBLIC_RECAPTCHA_SITE_KEY</code> is set. Google issues the key;
            it can't render without one. See SETUP.md.
          </div>
        )}

        <p class="required-note"><span class="req" aria-hidden="true">*</span> Required field</p>

        <button class="btn btn--cta" type="submit">Send message</button>
      </form>

      {/* No email address is published anywhere on this page: harvesting/spam
           (Jon, 2026-08-14). The form is the only contact route.

           Scope note (Jon, 2026-08-18): this rule is about PUBLIC pages, where
           any spammer can scrape the address. It does NOT extend to Stripe
           receipts, which carry Jon's real email on purpose - those go only to
           someone who has actually paid. See SETUP.md -> Receipts. */}
    </div>
  </main>

  <SiteFooter />

  {RECAPTCHA_SITE_KEY && (
    <script is:inline src="https://www.google.com/recaptcha/api.js" async defer></script>
  )}
</Base>

<style>
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    background: var(--white);
    border: 2px solid var(--ink);
    border-radius: 16px;
    padding: 2rem;
    box-shadow: 12px 12px 0 color-mix(in srgb, var(--teal) 30%, transparent);
  }
  .contact-form label {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font: 700 var(--text-sm)/1 var(--font-body);
    color: var(--ink);
  }
  .contact-form input,
  .contact-form textarea,
  .contact-form select {
    border: 2px solid var(--ink);
    border-radius: 10px;
    padding: 0.85rem 1rem;
    font: 500 var(--text-md)/1.5 var(--font-body);
    background: var(--white);
    color: var(--ink);
  }
  .contact-form input:focus,
  .contact-form textarea:focus,
  .contact-form select:focus {
    outline: 3px solid color-mix(in srgb, var(--blue) 40%, transparent);
  }
  .contact-form .btn {
    align-self: flex-start;
  }
  /* Visible only before the reCAPTCHA keys are set. Disappears automatically
     once PUBLIC_RECAPTCHA_SITE_KEY exists. */
  .captcha-placeholder {
    border: 2px dashed color-mix(in srgb, var(--ink) 35%, transparent);
    border-radius: 10px;
    padding: 1rem 1.1rem;
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--soft);
    background: color-mix(in srgb, var(--alt) 60%, var(--white));
  }
  .captcha-placeholder code {
    font-size: var(--text-xs);
    background: color-mix(in srgb, var(--ink) 8%, transparent);
    padding: 0.1rem 0.3rem;
    border-radius: 4px;
  }
  .required-note {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--soft);
  }
  /* Required-field asterisk */
  .label-row {
    display: block;
  }
  .req {
    color: var(--cta-shadow);
    font-weight: 800;
  }
  /* Note that sits under a field label, above the input */
  .field-note {
    font: 400 var(--text-sm)/1.5 var(--font-body);
    color: var(--soft);
    margin-bottom: 0.15rem;
  }
  .field-note a {
    color: var(--blue);
  }
  /* Validation styling. :user-invalid only applies AFTER the person has
     interacted with the field, so empty fields don't look like errors on load. */
  .contact-form input:user-invalid,
  .contact-form textarea:user-invalid,
  .contact-form select:user-invalid {
    border-color: var(--cta-shadow);
  }
  .hp {
    position: absolute !important;
    left: -9999px;
  }
  .banner {
    border-radius: 12px;
    padding: 1rem 1.2rem;
    margin-bottom: 1.4rem;
    font-size: var(--text-md);
  }
  .banner--ok {
    background: color-mix(in srgb, var(--teal) 12%, var(--white));
    border: 2px solid var(--teal);
    color: var(--ink);
  }
  .banner--err {
    background: color-mix(in srgb, var(--cta) 12%, var(--white));
    border: 2px solid var(--cta-shadow);
    color: var(--ink);
  }
</style>

<script>
  const params = new URLSearchParams(location.search);
  if (params.get('sent')) document.getElementById('sent-banner')?.removeAttribute('hidden');
  const err = params.get('error');
  if (err === 'captcha') document.getElementById('captcha-banner')?.removeAttribute('hidden');
  else if (err) document.getElementById('error-banner')?.removeAttribute('hidden');
</script>
